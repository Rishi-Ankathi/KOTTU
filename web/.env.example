# Copy to web/.env for local dev, or set this in your host's build environment.
#
# Base URL of the KOTTU API. Unset -> the site talks to http://127.0.0.1:8000
# (a local `uvicorn api.main:app`). In production, point it at the HF Space:
#
#   PUBLIC_KOTTU_API=https://<owner>-kottu-api.hf.space

PUBLIC_KOTTU_API=
