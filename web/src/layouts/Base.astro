---
import "../styles/tokens.css";
import "../styles/app.css";

const { title, active } = Astro.props;

const nav = [
  { href: "/", label: "Dashboard" },
  { href: "/authenticate/", label: "Authenticate" },
  { href: "/insights/", label: "Model Insights" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KOTTU verifies a person from the micro-timing of how they type a passphrase."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} · KOTTU` : "KOTTU"}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="bezel" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>

    <div class="wrap">
      <header class="topbar">
        <a class="mark" href="/">KOTTU<b>.</b></a>
        <nav class="nav">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={n.label === active ? "page" : undefined}
              >
                {n.label}
              </a>
            ))
          }
          <a href="https://github.com/Rishi-Ankathi/KOTTU">GitHub &#8599;</a>
        </nav>
      </header>

      <slot />

      <footer class="site-footer">
        <span>KOTTU v1.0 &middot; CMU DSL-StrongPasswordData</span>
        <a href="https://github.com/Rishi-Ankathi/KOTTU">GitHub</a>
      </footer>
    </div>
  </body>
</html>
